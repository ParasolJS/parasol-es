{
  "name": "parasol-es",
  "version": "2.0.0",
  "description": "ES module for interactive visualization of multi-objective optimization problems, based on d3 v7 and @jrkasprzyk/parcoord-es",
  "main": "dist/parasol.js",
  "module": "dist/parasol.esm.js",
  "jsnext:main": "dist/parasol.esm.js",
  "style": "dist/parcoords.css",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint --fix src",
    "prettier": "prettier --single-quote --trailing-comma es5 --write \"{src,__{demo,dist}__}/**/*.js\"",
    "dev": "rollup -c rollup.config.dev.mjs -w",
    "build": "rollup -c rollup.config.mjs",
    "prepublishOnly": "npm run build",
    "docs": "jsdoc src -r -d docs"
  },
  "files": [
    "src",
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParasolJS/parasol-es.git"
  },
  "keywords": [
    "es6",
    "d3v7",
    "Parasol",
    "parallel coordinates",
    "multiobjective optimization",
    "visualization"
  ],
  "author": "Josh Jacobson <joshuah.jacobson@gmail.com> (http://joshhjacobson.github.io)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ParasolJS/parasol-es/issues"
  },
  "homepage": "https://github.com/ParasolJS/parasol-es#readme",
  "devDependencies": {
    "@babel/cli": "^7.24.0",
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-runtime": "^7.24.0",
    "@babel/preset-env": "^8.0.2",
    "@babel/runtime": "^7.24.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "eslint": "^8.57.0",
    "jsdoc": "^4.0.2",
    "livereload": "^0.10.3",
    "prettier": "^3.2.5",
    "rollup": "^4.13.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "d3": "^7.0.0",
    "d3-dsv": "^3.0.0",
    "file-saver": "^1.3.8",
    "flatpickr": "^4.5.2",
    "jquery": "^3.3.1",
    "lodash-es": "^4.17.11",
    "ml-kmeans": "^4.2.1",
    "@jrkasprzyk/parcoord-es": "^3.0.0",
    "slickgrid-es6": "^3.0.1"
  }
}
